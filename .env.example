# Copy this to .env for local runs, or set these as Environment Variables
# in Render's dashboard for the deployed app. Never commit a real .env.

# A long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# The very first admin account. Bootstrapped automatically on first boot --
# after that account exists, these three can be removed from the environment
# (the account persists in the database either way).
ADMIN_EMAIL=you@fntcolorado.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Xiaohui
